{
    "name": "atldays/laravel-visitor",
    "description": "Laravel package for resolving typed visitor information from the current request, including IP address, user agent, geo data, and configurable fingerprints.",
    "keywords": [
        "laravel",
        "visitor",
        "ip",
        "user-agent",
        "fingerprint",
        "geo",
        "atldays"
    ],
    "license": "MIT",
    "homepage": "https://github.com/atldays/laravel-visitor",
    "support": {
        "issues": "https://github.com/atldays/laravel-visitor/issues",
        "source": "https://github.com/atldays/laravel-visitor"
    },
    "type": "library",
    "authors": [
        {
            "name": "Anjey Tsibylskij",
            "homepage": "https://github.com/atldays",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "atldays/laravel-agent": "^2.0",
        "atldays/laravel-geo": "^2.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "spatie/laravel-data": "^4.21",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Atldays\\Visitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atldays\\Visitor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atldays\\Visitor\\VisitorServiceProvider"
            ],
            "aliases": {
                "Visitor": "Atldays\\Visitor\\Facades\\Visitor",
                "VisitorManager": "Atldays\\Visitor\\Facades\\VisitorManager"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint",
        "format:test": "vendor/bin/pint --test",
        "hooks:install": "git config core.hooksPath .githooks"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
